{
  "columns": [
    {
      "id": "in_progress",
      "label": "DO",
      "match": ["do"],
      "visibleFields": ["id", "title", "badge", "project", "category"]
    },
    {
      "id": "ready",
      "label": "READY",
      "match": ["ready"],
      "visibleFields": ["id", "title", "badge", "project", "category"]
    },
    {
      "id": "todo",
      "label": "TODO",
      "match": ["todo"],
      "visibleFields": ["id", "title", "badge", "project", "category"]
    },
    {
      "id": "done",
      "label": "DONE",
      "match": ["done"],
      "limit": 5,
      "compact": true,
      "visibleFields": ["id", "title", "completedDate"]
    }
  ],
  "port": "__PORT__",
  "backlogDir": "__BACKLOG_DIR__",
  "defaultWorkspaceParent": "__WORKSPACE_PARENT__",
  "projects": [
    {
      "file": "__PROJECT_FILE__",
      "prefix": "__PROJECT_PREFIX__",
      "name": "__PROJECT_NAME__",
      "workspace": "__WORKSPACE_PATH__"
    },
    {
      "file": "inbox",
      "prefix": "IN",
      "name": "Inbox",
      "workspace": ""
    }
  ]
}
