{
  "columns": [
    {
      "id": "do",
      "label": "DO",
      "match": [
        "do"
      ],
      "visibleFields": [
        "id",
        "title",
        "badge",
        "project",
        "category"
      ]
    },
    {
      "id": "ready",
      "label": "READY",
      "match": [
        "ready"
      ],
      "visibleFields": [
        "id",
        "title",
        "badge",
        "project",
        "category"
      ]
    },
    {
      "id": "todo",
      "label": "TODO",
      "match": [
        "todo"
      ],
      "visibleFields": [
        "id",
        "title",
        "project"
      ]
    },
    {
      "id": "done",
      "label": "DONE",
      "match": [
        "done"
      ],
      "limit": 5,
      "compact": true,
      "visibleFields": [
        "id",
        "title",
        "completedDate"
      ]
    }
  ],
  "port": 3333,
  "backlogDir": "~/.backlog",
  "defaultWorkspaceParent": "C:/dev",
  "projects": [
    {
      "file": "your-project",
      "prefix": "YP",
      "name": "your-project",
      "workspace": "C:/dev/your-project",
      "summary": "このワークスペースの概要"
    },
    {
      "file": "inbox",
      "prefix": "IN",
      "name": "Inbox",
      "workspace": ""
    }
  ]
}
