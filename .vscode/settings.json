{
  // === ウィンドウ / テーマ設定（このワークスペース専用） ===
  // カラーテーマ。VS Code に同梱・インストール済みのテーマ名を指定する
  "workbench.colorTheme": "Green paper bitrix",

  // アイコンテーマ
  "workbench.iconTheme": "vscode-icons",

  // このワークスペースだけタイトルバー / アクティビティバーの色を変える。
  // 複数ウィンドウを開いたとき、どのプロジェクトか一目で分かるようになる
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#1e3a5f",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#1e3a5f99",
    "activityBar.background": "#1e3a5f"
  },

  // ウィンドウのタイトルバーに表示する文字列
  "window.title": "${rootName}${separator}${activeEditorShort}",

  // === エディタの基本設定（お好みで） ===
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "boundary",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
